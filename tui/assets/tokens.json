{
  "name": "SACRA TUI Lab",
  "version": "0.2.0",
  "status": "prototype",
  "basePalette": "SACRA UI 1.4.3",
  "colors": {
    "--s-color-canvas": "#15191F",
    "--s-color-surface": "#1B2027",
    "--s-color-raised": "#222831",
    "--s-color-sunken": "#11151A",
    "--s-color-hover": "#29313B",
    "--s-color-border": "#2A3038",
    "--s-color-border-strong": "#414B58",
    "--s-color-text": "#F2F4F6",
    "--s-color-muted": "#9BA3AE",
    "--s-color-subtle": "#747E8C",
    "--s-color-accent": "#F2CC4D",
    "--s-color-accent-hover": "#FFDD6B",
    "--s-color-accent-soft": "rgba(242,204,77,.07)",
    "--s-color-success": "#45BF92",
    "--s-color-success-soft": "rgba(69,191,146,.09)",
    "--s-color-danger": "#EF7B6D",
    "--s-color-danger-soft": "rgba(239,123,109,.09)"
  },
  "terminal": {
    "fontSizePxPreview": 12,
    "rowHeightPxPreview": 20,
    "horizontalUnit": "1 cell / 1ch",
    "verticalUnit": "1 row",
    "paddingCells": [
      1,
      2
    ],
    "gapCells": 2,
    "borderRadius": 0,
    "shadows": false,
    "contentBreakpointsCells": {
      "wide": 132,
      "compact": 96,
      "stacked": 64
    }
  },
  "chart": {
    "source": "ultra-mog",
    "revision": "7975feefe2e3530cd026ec99dfe6d862a6e9e02f",
    "pixelRowsPerCell": 12,
    "pixelColumnsPerCell": "round(12 * cellWidth / cellHeight), clamped 2..10",
    "octantSubcells": [
      2,
      4
    ],
    "gapThresholdMs": 20000,
    "windowsMs": [
      60000,
      300000,
      900000
    ],
    "sampleIntervalMs": 1000,
    "maxRasterPixels": 2640000
  },
  "statusSemantics": {
    "focus": "accent + outline",
    "selection": "accent-soft + leading marker",
    "success": "success + [OK]",
    "error": "danger + [ERR]",
    "unavailable": "muted + [N/A]"
  },
  "glyphs": {
    "box": "┌┐└┘─│├┤┬┴┼",
    "spark": "▁▂▃▄▅▆▇█",
    "sparkASCII": ".:-=+*#@",
    "progress": "█░",
    "lineASCII": [
      "*",
      "+"
    ]
  }
}
