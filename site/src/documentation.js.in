d:var(--s-color-raised); }\n.s-selectbox__button[aria-invalid=\"true\"] { border-color:var(--s-color-danger); }\n.s-selectbox__button:disabled { color:var(--s-color-subtle); border-color:var(--s-color-border); cursor:not-allowed; opacity:.65; }\n.s-selectbox__label { display:block; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n.s-selectbox__caret { width:18px; height:18px; flex:0 0 18px; color:var(--s-color-accent); fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:square; stroke-linejoin:miter; transition:transform var(--s-duration-fast); }\n.s-selectbox__button[aria-expanded=\"true\"] .s-selectbox__caret { transform:rotate(180deg); }\n.s-selectbox__button:disabled .s-selectbox__caret { color:var(--s-color-subtle); }\n.s-selectbox__list { box-sizing:border-box; position:fixed; inset:auto; z-index:10000; display:block; margin:0; padding:6px; border:1px solid var(--s-color-border-strong); border-top:2px solid var(--s-color-accent); border-radius:var(--s-radius-sm); background:var(--s-color-raised); color:var(--s-color-text); font:400 var(--s-type-xs)/1.5 var(--s-font); box-shadow:var(--s-shadow-overlay); overflow-y:auto; overflow-x:hidden; overscroll-behavior:contain; max-height:256px; scrollbar-width:thin; scrollbar-color:var(--s-color-border-strong) var(--s-color-raised); -webkit-tap-highlight-color:transparent; }\n.s-selectbox__list[hidden] { display:none!important; }\n.s-selectbox__list[popover]:not(:popover-open) { display:none; }\n.s-selectbox__list::backdrop { background:transparent; pointer-events:none; }\n.s-selectbox__option { box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:38px; padding:8px 10px; border:1px solid transparent; border-radius:var(--s-radius-sm); cursor:pointer; user-select:none; -webkit-user-select:none; }\n.s-selectbox__option > span { min-width:0; overflow-wrap:anywhere; }\n.s-selectbox__option[hidden] { display:none!important; }\n.s-selectbox__option.is-active { border-color:var(--s-color-border-strong); background:var(--s-color-hover); }\n.s-selectbox__option.is-selected { color:var(--s-color-accent); }\n.s-selectbox__option.is-selected.is-active { border-color:var(--s-color-accent); background:var(--s-color-accent-soft); }\n.s-selectbox__check { width:16px; height:16px; flex:0 0 16px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:square; stroke-linejoin:miter; visibility:hidden; }\n.s-selectbox__option.is-selected .s-selectbox__check { visibility:visible; }\n.s-selectbox__option[aria-disabled=\"true\"] { color:var(--s-color-subtle); cursor:not-allowed; opacity:.6; }\n.s-selectbox__group { padding:8px 10px 5px; font-size:10px; letter-spacing:.08em; color:var(--s-color-muted); text-transform:uppercase; }\n.s-filterbar > .s-selectbox { flex:0 1 176px; }\n.s-kanban__card > .s-selectbox { width:100%; margin-top:10px; }\n.s-kanban__card .s-selectbox__button { min-height:34px; padding:7px; font-size:10px!important; }\n.s-inspector .s-selectbox { width:100%; }\n@media(max-width:600px) { .s-selectbox__button { min-height:44px; } .s-selectbox__option { min-height:44px; } }\n@media(prefers-reduced-motion:reduce) { .s-selectbox__button,.s-selectbox__caret { transition:none; } }\n@media(forced-colors:active) { .s-selectbox__button,.s-selectbox__list { border-color:ButtonText; background:Canvas; color:CanvasText; } .s-selectbox__option.is-active { outline:2px solid Highlight; } .s-selectbox__option.is-selected { color:Highlight; } }\n\n/* SACRA UI 1.4.3 — copy confirmation and visible keyboard focus. */\n.s-feedback-icon { width:20px; height:20px; flex:0 0 20px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }\n.s-btn.is-copied { position:relative; border-color:var(--s-color-success); background:var(--s-color-success-soft); color:var(--s-color-success); }\n.s-copy__original { display:inline-flex; align-items:center; justify-content:center; gap:inherit; visibility:hidden; }\n.s-copy__feedback { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; gap:6px; padding:2px 6px; white-space:nowrap; pointer-events:none; }\n.s-copy__feedback .s-feedback-icon { width:17px; height:17px; flex-basis:17px; }\n.s-copy-buffer { position:fixed; inset:0 auto auto 0; width:1px; height:1px; padding:0; border:0; opacity:0; font-size:16px; }\n.s-notice-region { position:fixed; inset:auto max(24px,env(safe-area-inset-right)) max(24px,env(safe-area-inset-bottom)) auto; z-index:1000; width:min(360px,calc(100vw - 32px)); pointer-events:none; font:400 var(--s-type-sm)/1.6 var(--s-font); color:var(--s-color-text); }\n.s-notice { display:flex; align-items:flex-start; gap:12px; padding:16px; border:1px solid var(--s-color-border-strong); border-left:2px solid var(--s-color-accent); border-radius:var(--s-radius-md); background:var(--s-color-raised); box-shadow:var(--s-shadow-overlay); pointer-events:auto; }\n.s-notice > .s-feedback-icon { color:var(--s-color-accent); margin-top:1px; }\n.s-notice--success { border-left-color:var(--s-color-success); }\n.s-notice--success > .s-feedback-icon { color:var(--s-color-success); }\n.s-notice--error { border-left-color:var(--s-color-danger); }\n.s-notice--error > .s-feedback-icon { color:var(--s-color-danger); }\n.s-notice__text { display:grid; gap:3px; min-width:0; flex:1; }\n.s-notice__text strong { font-weight:600; font-size:12px; }\n.s-notice__text span { font-size:11px; color:var(--s-color-muted); overflow-wrap:anywhere; }\n.s-notice__close { appearance:none; flex:0 0 28px; width:28px; height:28px; border:0; border-radius:var(--s-radius-sm); padding:4px; background:transparent; color:var(--s-color-muted); cursor:pointer; }\n.s-notice__close:hover { color:var(--s-color-text); background:var(--s-color-hover); }\n.s-copy-dialog .s-dialog__body { display:grid; gap:12px; }\n.s-copy-dialog .s-dialog__body p { margin:0; }\n.s-copy-dialog textarea { font-size:12px; }\n.s-focus-demo { display:grid; gap:14px; border-top:1px solid var(--s-color-border); padding-top:20px; }\n.s-focus-demo p { margin:0; color:var(--s-color-muted); font-size:11px; line-height:1.8; }\n.s-focus-demo .ds-specimen-label { margin:0; }\n.s-focus-demo__keys { display:flex; flex-wrap:wrap; gap:8px 18px; color:var(--s-color-muted); font-size:10px; }\n.s-focus-demo__keys > span { display:inline-flex; gap:6px; align-items:center; }\n.s-focus-demo__target.is-focus-preview { outline:2px solid var(--s-color-accent); outline-offset:4px; }\n.s-focus-demo__status { font-size:10px; color:var(--s-color-muted); min-height:1.8em; }\n.s-focus-demo__status[data-focused=\"true\"] { color:var(--s-color-accent); }\n.s-feedback-demo { display:grid; gap:18px; max-width:740px; padding:28px; }\n@media(max-width:600px){ .s-notice-region { right:16px; bottom:max(16px,env(safe-area-inset-bottom)); } .s-notice { padding:13px; gap:9px; } .s-focus-demo .s-row { gap:14px; } }\n@media(forced-colors:active){ .s-focus-demo__target.is-focus-preview { outline-color:Highlight; } .s-btn.is-copied { border-color:ButtonText; color:ButtonText; } .s-feedback-icon { forced-color-adjust:auto; } }\n";
  const AGENT_RULES = "Используй SACRA UI 1.4.3 / Technical Editorial.\nПодключи sacra-ui.css, добавь s-root на body. Классы s-* переиспользуемые; ds-* только для витрины.\nСохрани палитру: canvas #15191F, surface #1B2027, raised #222831, inset #11151A, accent #F2CC4D, text #F2F4F6, muted #9BA3AE, success #45BF92, danger #EF7B6D.\nСтиль: Swiss-сетка + сдержанный брутализм + монохромная Y2K/cyber-геометрия. Без радуги, свечения, стекла и чёрного full-background.\n12 колонок; шаг отступов 4px; радиусы 2/4/6/8px. Крупные заголовки, малые нумерованные подписи, строгие линейки и координатные метки.\nШрифт: локальный Liga SFMono Nerd Font → SF Mono → Menlo → monospace. Никаких вложенных файлов шрифтов или внешних font CDN. Иконки — SVG.\nЦвета, ритм, радиусы, типографику бери из --s-*; не добавляй локальные случайные цвета.\nГрафика: s-tech-frame, s-dotgrid, s-scanlines, s-hatch; SVG-каркас и муар — только в обложке, заставке или отдельной вставке. Не накладывай текстуру на текст, форму или таблицу.\nРабочая зона спокойная: s-panel, s-table, s-input, s-btn. В таблицах только горизонтальные разделители, состояния дублируются текстом и символом.\nДля редакционной оболочки: s-kicker, s-editorial-title, s-register, s-rail. Для технических данных: s-readout и s-scale. Шкала с реальными данными должна соответствовать значениям; декоративные примеры явно помечай.\nКлавиатура, aria-метки, заметный focus-visible, нативные input/dialog, reduced-motion обязательны. Графику без смысловых данных исключай из accessibility tree.\nНа мобильных сетка складывается, таблица прокручивается внутри своего контейнера. Проверяй 320/390/768/1440px.\nНикаких фоновых API-запросов. Демо-данные не выдавай за измерения. Не встраивай фиктивные QR и случайные confidence-показатели.\n\nWASM: используйте SacraMotion.mount(canvas, options) после SacraMotion.ready. Реальный geometry.wasm без импортов; C-код вычисляет вершины. JS Canvas2D рисует их. Предусмотрите play/pause, reduced-motion, автопаузу вне экрана; FPS показывайте только измеренный.\nГрафики: SacraCharts.mount(host, {type,title,unit,data,...}). Подписи осей и числовые шкалы обязательны. Цвет не единственный канал. Таблица данных, CSV/JSON/SVG и управление с клавиатуры обязательны. Примеры синтетические, не телеметрия.\nWorkspace: SacraWorkspace.mount(host,{persist:false}). Локальный прототип, без shell и сети. Доска/таблица/инспектор используют одно состояние. Перетаскивание дублируется доступным выбором статуса.\nОдиночные select: подключай src/sacra-controls.js. Собственный DOM listbox, не системное меню и не только CSS. После программного value без событий вызывай SacraControls.refresh. Сохраняй семантику формы и клавиатурное управление; не меняй существующую галочку.\nКопирование: SacraUtils.copy(text, {trigger: event.currentTarget, message: \"Текст в буфере обмена.\"}). Передавай кнопку явно, не полагайся на document.activeElement (Safari). Галочка и уведомление только после подтверждения записи. Никакого фальшивого успеха при ошибке. Жёлтый контур — фокус с клавиатуры; зелёная галочка — успешное действие.";
  const taskNames = ['Сводка', 'Сортировка файлов', 'Извлечение JSON'];
  const esc = (value) => String(value).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const svg = (name, cls = '') => `<svg class="s-icon ${cls}" aria-hidden="true"><use href="#i-${name}"></use></svg>`;
  function toast(text, isError = false) {
    return SacraUtils.notify(text, {kind: isError ? 'error' : 'info'});
  }
  function copy(text, message = 'Текст в буфере обмена.', trigger = null) {
    return SacraUtils.copy(text, {trigger, message});
  }
  function download(name, text, type) {
    const url = URL.createObjectURL(new Blob([text], { type }));
    const link = document.createElement('a'); link.href = url; link.download = name;
    document.body.appendChild(link); link.click(); link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 10000);
  }
  $$('[data-export-css]').forEach(b => b.addEventListener('click', () => download('sacra-ui.css', CSS_EXPORT, 'text/css;charset=utf-8')));
  $$('[data-copy]').forEach(b => b.addEventListener('click', () => copy(b.dataset.copy, `${b.dataset.copyLabel || 'Значение'} → буфер обмена.`, b)));
  $$('[data-copy-target]').forEach(b => b.addEventListener('click', () => copy(document.getElementById(b.dataset.copyTarget).textContent, 'HTML в буфере обмена.', b)));
  $$('[data-demo-toast]').forEach(b => b.addEventListener('click', () => toast(b.dataset.demoToast)));
  $$('[data-close]').forEach(b => b.addEventListener('click', () => document.getElementById(b.dataset.close).close()));
  $$('dialog').forEach(dialog => dialog.addEventListener('click', event => {
    const r = dialog.getBoundingClientRect();
    if (event.target === dialog && (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)) dialog.close();
  }));
  let filter = 'all', query = '', ascending = null, highlight = 2, selectedModel = null;
  function visibleModels() {
    let result = MODELS.filter(m => m.name.toLowerCase().includes(query) && (filter === 'all' || m.results.every(x => x.ok) === (filter === 'pass')));
    if (ascending !== null) result.sort((a,b) => a.name.localeCompare(b.name, 'en', { numeric: true }) * (ascending ? 1 : -1));
    return result;
  }
  function statusHTML(r) { return `<span class="s-status">${svg(r.ok ? 'check' : 'x', r.ok ? 's-success' : 's-danger')}<span class="s-sr">${r.ok ? 'Успешно' : 'Ошибка'}: </span><span class="s-muted">${esc(r.text)}</span></span>`; }
  function renderTable() {
    const models = visibleModels();
    $('#model-rows').innerHTML = models.map(m => `<tr><td class="ds-row-index">${String(MODELS.indexOf(m)+1).padStart(2,'0')}</td><td><button type="button" class="ds-model-link" data-model="${m.id}" aria-label="Детали модели ${esc(m.name)}">${esc(m.name)}</button></td><td>${esc(m.parameters)}${m.note ? `<small class="ds-model-meta">${esc(m.note)}</small>` : ''}</td>${m.results.map((r,i) => `<td class="${i === highlight ? 'is-highlight' : ''}" data-col="${i}">${statusHTML(r)}</td>`).join('')}</tr>`).join('');
    $('#model-count').textContent = `${models.length} / ${MODELS.length}`;
    $('#model-empty').hidden = models.length > 0;
    $$('[data-model]').forEach(button => button.addEventListener('click', () => openModel(button.dataset.model)));
  }
  $$('[data-filter]').forEach(b => b.addEventListener('click', () => {
    filter = b.dataset.filter;
    $$('[data-filter]').forEach(x => x.setAttribute('aria-pressed', String(x === b))); renderTable();
  }));
  $('#model-search').addEventListener('input', event => { query = event.target.value.trim().toLowerCase(); renderTable(); });
  $('#reset-models').addEventListener('click', () => { query = ''; $('#model-search').value = ''; $('[data-filter="all"]').click(); });
  $('#sort-model').addEventListener('click', () => { ascending = ascending === null ? true : !ascending; $('#name-heading').setAttribute('aria-sort', ascending ? 'ascending' : 'descending'); renderTable(); });
  $$('[data-highlight]').forEach(b => b.addEventListener('click', () => {
    highlight = Number(b.dataset.highlight);
    $$('thead [data-col]').forEach(th => th.classList.toggle('is-highlight', Number(th.dataset.col) === highlight));
    $$('[data-highlight]').forEach(x => x.setAttribute('aria-pressed', String(x === b))); renderTable();
  }));
  function modelJSON(m) {
    return { model: m.name, parameters: m.parameters, architecture_note: m.note || null,
      source: 'User-provided screenshots; illustrative reference data, not independently verified.',
      tasks: Object.fromEntries(m.results.map((r,i) => [['summarize','sort_files','extract_json'][i], {passed:r.ok, result:r.text}])) };
  }
  function openModel(id) {
    selectedModel = MODELS.find(m => m.id === id); if (!selectedModel) return;
    $('#model-dialog-title').textContent = selectedModel.name;
    $('#model-dialog-content').innerHTML = `<dl class="ds-model-details"><div><dt>Параметры</dt><dd>${esc(selectedModel.parameters)}</dd></div><div><dt>Пройдено задач</dt><dd>${selectedModel.results.filter(x=>x.ok).length} / 3</dd></div></dl>${selectedModel.results.map((r,i) => `<div class="ds-modal-result"><span>${taskNames[i]}</span>${statusHTML(r)}</div>`).join('')}<p class="ds-caption" style="margin-top:20px">${selectedModel.note ? esc(selectedModel.note) + '. ' : ''}Результаты со скриншотов пользователя. Вызов инструмента (Task 4) в них не оценён и сюда не добавлен.</p>`;
    $('#model-dialog').showModal();
  }
  $('#copy-model-json').addEventListener('click', event => { if (selectedModel) copy(JSON.stringify(modelJSON(selectedModel), null, 2), 'JSON модели в буфере обмена.', event.currentTarget); });
  $('#export-models').addEventListener('click', () => download('sacra-reference-models.json', JSON.stringify(visibleModels().map(modelJSON), null, 2), 'application/json;charset=utf-8'));
  renderTable();

  // Local font is an enhancement, never a requirement: icons stay SVG and the UI keeps the SF Mono fallback stack.
  async function detectFont() {
    let loaded = false;
    try {
      const faces = await document.fonts.load('400 12px "Sacra Mono"', 'AaБб0123');
      loaded = faces.length > 0;
    } catch (_) {}
    $$('[data-font-name]').forEach(el => {
      el.textContent = loaded ? 'Liga SFMono Nerd Font' : 'SF Mono / Nerd stack';
      el.classList.toggle('s-success', loaded);
    });
    $$('[data-font-detail]').forEach(el => {
      el.textContent = loaded ? 'Nerd Font · local' : 'SVG icons · independent';
    });
    $('#font-badge').textContent = loaded ? 'NERD · ACTIVE' : 'LOCAL STACK';
    $('#font-badge').classList.toggle('s-badge--success', loaded);
    $('#glyph-note').textContent = 'Встроенные SVG-иконки — одинаково выглядят без зависимости от установленного шрифта.';
  }
  detectFont();
  $('#type-size').addEventListener('input', event => { const size = Number(event.target.value); $('#type-preview').style.fontSize = `${size}px`; $('#type-size-output').textContent = `${size} px`; });
  $('#ligatures').addEventListener('change', event => { $('#type-preview').style.fontVariantLigatures = event.target.checked ? 'contextual common-ligatures' : 'none'; });
  $('#type-preview').addEventListener('paste', event => { event.preventDefault(); const text = event.clipboardData.getData('text/plain').slice(0,250); document.execCommand('insertText', false, text); });
  $('#type-preview').addEventListener('keydown', event => { if(event.key === 'Enter') event.preventDefault(); });

  const focusTarget = $('#focus-demo-target'), focusStart = $('#focus-demo-start');
  const focusStatus = $('#focus-demo-status');
  focusStart.addEventListener('click', () => {
    focusTarget.classList.add('is-focus-preview');
    focusTarget.focus({preventScroll:true});
  });
  focusTarget.addEventListener('focus', () => {
    focusStatus.dataset.focused = 'true';
    focusStatus.textContent = 'Сейчас выбрана тестовая кнопка. Enter — нажать.';
  });
  focusTarget.addEventListener('blur', () => {
    focusTarget.classList.remove('is-focus-preview');
    focusStatus.dataset.focused = 'false';
    focusStatus.textContent = 'Фокус ушёл с тестовой кнопки — контур исчез.';
  });
  focusTarget.addEventListener('click', () => {
    SacraUtils.notify('Это демонстрация, данные не менялись.', {title:'Тестовая кнопка нажата',trigger:focusTarget});
  });

  const tabs = $$('[role="tab"]', $('#components'));
  function activateTab(tab, moveFocus = false) {
    tabs.forEach(t => { const active = t === tab; t.setAttribute('aria-selected', String(active)); t.tabIndex = active ? 0 : -1; document.getElementById(t.getAttribute('aria-controls')).hidden = !active; });
    if (moveFocus) tab.focus();
  }
  tabs.forEach(tab => { tab.addEventListener('click', () => activateTab(tab)); tab.addEventListener('keydown', event => {
    let i = tabs.indexOf(tab);
    if (event.key === 'ArrowRight') i = (i + 1) % tabs.length;
    else if (event.key === 'ArrowLeft') i = (i - 1 + tabs.length) % tabs.length;
    else if (event.key === 'Home') i = 0;
    else if (event.key === 'End') i = tabs.length - 1;
    else return;
    event.preventDefault(); activateTab(tabs[i], true);
  }); });
  $('#demo-run').addEventListener('click', async event => {
    const b = event.currentTarget; b.disabled = true; b.setAttribute('aria-busy','true'); b.innerHTML = '<span class="s-spinner" aria-hidden="true"></span>Выполнение…';
    await new Promise(r => setTimeout(r,1100));
    b.disabled = false; b.removeAttribute('aria-busy'); b.innerHTML = svg('play') + 'Запустить'; toast('Демо выполнено. Внешних запросов нет.');
  });
  $('#demo-info').addEventListener('click', () => $('#info-dialog').showModal());
  $('#demo-info-2').addEventListener('click', () => $('#info-dialog').showModal());
  $('#demo-delete').addEventListener('click', () => $('#delete-dialog').showModal());
  $('#confirm-demo-delete').addEventListener('click', () => { $('#delete-dialog').close(); toast('Демо: удаление подтверждено. Реальные данные не затронуты.'); });
  $('#demo-form').addEventListener('submit', event => {
    event.preventDefault();
    const input = $('#task-name'); const valid = /^[a-z0-9][a-z0-9-]{2,47}$/i.test(input.value.trim());
    input.setAttribute('aria-invalid', String(!valid));
    $('#task-help').textContent = valid ? 'Название подходит. Это локальная демонстрация формы.' : 'Нужно 3–48 символов: латинские буквы, цифры, дефис. Первый символ — буква или цифра.';
    $('#task-help').style.color = valid ? 'var(--s-color-success)' : 'var(--s-color-danger)';
    if (valid) toast('Форма проверена. Данные никуда не отправлялись.'); else input.focus();
  });
  $('#demo-stream').addEventListener('change', e => { $('#stream-note').textContent = `Потоковый вывод ${e.target.checked ? 'включён' : 'выключен'}.`; });
  $('#demo-add').addEventListener('click', async () => { $('#empty-demo').hidden = true; $('#empty-loading').hidden = false; await new Promise(r => setTimeout(r,950)); $('#empty-loading').hidden = true; $('#empty-complete').hidden = false; $('#demo-add-reset').focus({preventScroll:true}); });
  $('#demo-add-reset').addEventListener('click', () => { $('#empty-complete').hidden = true; $('#empty-demo').hidden = false; $('#demo-add').focus({preventScroll:true}); });
  $('#copy-agent-rules').addEventListener('click', event => copy(AGENT_RULES, 'Правила для агента в буфере обмена.', event.currentTarget));
  $('#download-demo-result').addEventListener('click', () => download('result.example.json', JSON.stringify({ _demo: true, invoice_number:'DEMO-001', invoice_date:'2026-10-01', seller:'Демонстрационный поставщик', buyer:'Демонстрационный покупатель', currency:'RUB', products:[{name:'Пример товара',quantity:2,unit_price:100,total:200}], total:200, status:'example' }, null, 2), 'application/json;charset=utf-8'));

  const entries = [
    ['Motion / WASM / анимация', 'motion-lab', 'play', '6 форм'],
    ['Графики / Sankey / свечи / treemap', 'charts', 'table', '12 типов'],
    ['Workspace / доска / инспектор / логи', 'workspace', 'layers', 'Локальное демо'],
    ['Визуальный язык / Swiss + Cyber', 'visual-language', 'palette', 'Edition 04'],
    ['Геометрия / каркас / муар / сетка', 'visual-language', 'grid', 'Образцы'],
    ['Обзор', 'overview', 'grid', 'Основа'], ['Эталонная таблица', 'reference-table', 'table', '8 моделей'],
    ['Палитра и токены', 'palette', 'palette', 'Цвет'], ['Отступы и радиусы', 'palette', 'grid', '4 px'],
    ['Шрифт и типографика', 'typography', 'type', 'SFMono'], ['Nerd Font / иконки', 'typography', 'terminal', 'Глифы'],
    ['Кнопки', 'components', 'box', 'Компоненты', 'buttons'], ['Поля и формы', 'components', 'settings', 'Компоненты', 'inputs'],
    ['Карточки, списки и метрики', 'components', 'table', 'Компоненты', 'data'], ['Диалоги и сообщения', 'components', 'box', 'Компоненты', 'overlays'],
    ['Статусы и прогресс', 'components', 'check', 'Компоненты', 'status'], ['Навигация', 'components', 'layers', 'Компоненты', 'navigation'],
    ['Паттерны и терминал', 'patterns', 'terminal', 'Шаблоны'], ['Внедрение и правила', 'usage', 'code', 'Разработка'],
  ];
  function goTo(entry) {
    $('#command-dialog').close();
    if (entry[4]) activateTab(document.getElementById(`tab-${entry[4]}`));
    document.getElementById(entry[1]).scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
  }
  function renderCommands() {
    const search = $('#command-input').value.trim().toLowerCase();
    const filtered = entries.filter(e => e.join(' ').toLowerCase().includes(search));
    const list = $('#command-results'); list.innerHTML = '';
    filtered.forEach(entry => {
      const b = document.createElement('button'); b.type = 'button'; b.className = 'ds-command-item';
      b.innerHTML = `${svg(entry[2])}<span>${esc(entry[0])}</span><small>${esc(entry[3])}</small>`;
      b.addEventListener('click', () => goTo(entry)); list.appendChild(b);
    });
    if (!filtered.length) list.innerHTML = '<div class="s-empty"><p>Ничего не найдено.</p></div>';
  }
  function openCommand() { if ($('#command-dialog').open) return; $('#command-input').value = ''; renderCommands(); $('#command-dialog').showModal(); $('#command-input').focus(); }
  $('#command-open').addEventListener('click', openCommand);
  $$('[data-open-command]').forEach(b => b.addEventListener('click', openCommand));
  $('#command-input').addEventListener('input', renderCommands);
  $('#command-dialog').addEventListener('keydown', event => {
    const buttons = $$('.ds-command-item');
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault(); const direction = event.key === 'ArrowDown' ? 1 : -1;
      let index = buttons.indexOf(document.activeElement);
      index = index < 0 ? (direction === 1 ? 0 : buttons.length-1) : (index+direction+buttons.length)%buttons.length;
      buttons[index]?.focus();
    } else if (event.key === 'Enter' && document.activeElement === $('#command-input')) { event.preventDefault(); buttons[0]?.click(); }
  });
  document.addEventListener('keydown', event => {
    const editing = event.target.closest('input,textarea,select,[contenteditable="true"]');
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); if (!$('dialog[open]') || $('#command-dialog').open) openCommand(); }
    else if(event.key === '/' && !editing && !$('dialog[open]')) { event.preventDefault(); openCommand(); }
  });
  $('#mobile-menu').addEventListener('click', () => $('#mobile-nav-dialog').showModal());
  $$('[data-mobile-link]').forEach(a => a.addEventListener('click', () => $('#mobile-nav-dialog').close()));
  const navSections = $$('.ds-section');
  const updateNav = () => {
    let current = navSections[0];
    navSections.forEach(section => { if (section.getBoundingClientRect().top <= 170) current = section; });
    $$('[data-nav]').forEach(a => { const active = a.getAttribute('href') === `#${current.id}`; a.classList.toggle('is-active', active); if(active) {a.setAttribute('aria-current','location'); $('#crumb-current').textContent = $('span', a).textContent;} else a.removeAttribute('aria-current'); });
  };
  let scrollPending = false;
  window.addEventListener('scroll', () => { if (!scrollPending) { scrollPending = true; requestAnimationFrame(() => {updateNav(); scrollPending = false;}); } }, {passive:true});
  updateNav();

  // Deterministic geometric specimen; it is not a telemetry chart.
  let formMode = 'mesh';
  function projectForm(u, v, rotation) {
    const radius = 1 + .10 * Math.cos(3*u), tube = .34 + .055 * Math.sin(2*u);
    let x=(radius+tube*Math.cos(v))*Math.cos(u), y=(radius+tube*Math.cos(v))*Math.sin(u), z=tube*Math.sin(v)+.15*Math.sin(3*u);
    const a=57*Math.PI/180, b=10*Math.PI/180, c=rotation*Math.PI/180;
    [y,z]=[y*Math.cos(a)-z*Math.sin(a),y*Math.sin(a)+z*Math.cos(a)];
    [x,z]=[x*Math.cos(b)+z*Math.sin(b),-x*Math.sin(b)+z*Math.cos(b)];
    [x,y]=[x*Math.cos(c)-y*Math.sin(c),x*Math.sin(c)+y*Math.cos(c)];
    const perspective=4.8/(4.8+z);
    return [260+x*158*perspective,200+y*158*perspective,z];
  }
  function renderForm() {
    const density=Number($('#lab-density').value), angle=Number($('#lab-angle').value), curves=[];
    const addCurve=(points,cross=false)=>curves.push({points,cross,z:points.reduce((s,p)=>s+p[2],0)/points.length});
    for(let j=0;j<density;j++) addCurve(Array.from({length:101},(_,k)=>projectForm(2*Math.PI*k/100,2*Math.PI*j/density,angle)));
    if(formMode==='mesh') {
      const count=Math.ceil(density*.65);
      for(let j=0;j<count;j++) addCurve(Array.from({length:49},(_,k)=>projectForm(2*Math.PI*j/count,2*Math.PI*k/48,angle)),true);
    }
    curves.sort((a,b)=>b.z-a.z);
    $('[data-form-lines]',$('#lab-form')).innerHTML=curves.map(({points,cross,z})=>{
      const opacity=cross ? .32 : Math.max(.24,Math.min(.86,.60-z*.2));
      const d='M'+points.map(p=>`${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' L');
      return `<path d="${d}" stroke-opacity="${opacity.toFixed(2)}" stroke-width="${cross ? .65 : .95}"/>`;
    }).join('');
    $('#lab-density-value').textContent=density;
    const displayAngle=String(angle).replace('-','−')+'°';
    $('#lab-angle-value').textContent=displayAngle;
    $('#lab-readout').textContent=`${density} ЛИНИЙ / ${displayAngle}`;
    $('#lab-angle').setAttribute('aria-valuetext',`${angle} градусов`);
    $('#lab-density').setAttribute('aria-valuetext',`${density} продольных линий`);
    $$('[data-form-mode]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.formMode===formMode)));
  }
  let renderPending=false;
  function queueForm() {
    if(renderPending) return;
    renderPending=true;
    requestAnimationFrame(()=>{renderForm();renderPending=false;});
  }
  ['lab-density','lab-angle'].forEach(id=>document.getElementById(id).addEventListener('input',queueForm));
  $$('[data-form-mode]').forEach(button=>button.addEventListener('click',()=>{formMode=button.dataset.formMode;renderForm();}));
  function applyGrid() {
    const show=$('#lab-grid').checked;
    $('#lab-stage').classList.toggle('s-dotgrid',show);
    $('[data-form-guides]',$('#lab-form')).style.display=show?'':'none';
  }
  $('#lab-grid').addEventListener('change',applyGrid);
  $('#lab-reset').addEventListener('click',()=>{
    $('#lab-density').value='28';$('#lab-angle').value='-18';$('#lab-grid').checked=true;formMode='mesh';applyGrid();renderForm();
  });
  $('#export-form').addEventListener('click',()=>{
    // Flush the latest slider values before exporting the actual geometry.
    renderForm();
    const copy=$('#lab-form').cloneNode(true);
    copy.removeAttribute('id');copy.removeAttribute('aria-hidden');copy.removeAttribute('class');
    copy.setAttribute('width','520');copy.setAttribute('height','400');copy.setAttribute('role','img');
    copy.setAttribute('aria-label','SACRA / декоративная геометрия');
    copy.setAttribute('style','color:#F2CC4D;background:#1B2027');
    const backdrop=document.createElementNS('http://www.w3.org/2000/svg','rect');
    backdrop.setAttribute('width','520');backdrop.setAttribute('height','400');backdrop.setAttribute('fill','#1B2027');copy.insertBefore(backdrop,copy.firstChild);
    const svgText=new XMLSerializer().serializeToString(copy);
    download('sacra-form.svg',svgText,'image/svg+xml;charset=utf-8');
  });
  renderForm();

})();
