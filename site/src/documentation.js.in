  const CSS_EXPORT = "/* SACRA UI 1.4.3 — graphite theme, 4px scale. */\n/* Local font only: no font assets, network requests or embedded font data. */\n@font-face {\n  font-family: \"Sacra Mono\";\n  src: local(\"Liga SFMono Nerd Font\"), local(\"LigaSFMonoNerdFont-Regular\"), local(\"Liga SFMono Nerd Font Regular\"), local(\"SFMono Nerd Font\"), local(\"SFMono Nerd Font Mono\");\n  font-style: normal; font-weight: 400; font-display: swap;\n}\n@font-face {\n  font-family: \"Sacra Mono\";\n  src: local(\"Liga SFMono Nerd Font Medium\"), local(\"LigaSFMonoNerdFont-Medium\"), local(\"Liga SFMono Nerd Font\"), local(\"SFMono Nerd Font\");\n  font-style: normal; font-weight: 500; font-display: swap;\n}\n@font-face {\n  font-family: \"Sacra Mono\";\n  src: local(\"Liga SFMono Nerd Font Semibold\"), local(\"LigaSFMonoNerdFont-Semibold\"), local(\"Liga SFMono Nerd Font\"), local(\"LigaSFMonoNerdFont-Bold\"), local(\"SFMono Nerd Font\");\n  font-style: normal; font-weight: 600; font-display: swap;\n}\n@font-face {\n  font-family: \"Sacra Mono\";\n  src: local(\"Liga SFMono Nerd Font Bold\"), local(\"LigaSFMonoNerdFont-Bold\"), local(\"Liga SFMono Nerd Font\"), local(\"SFMono Nerd Font\");\n  font-style: normal; font-weight: 700; font-display: swap;\n}\n\n:root {\n  color-scheme: dark;\n  --s-color-canvas: #15191F;\n  --s-color-surface: #1B2027;\n  --s-color-raised: #222831;\n  --s-color-sunken: #11151A;\n  --s-color-hover: #29313B;\n  --s-color-border: #2A3038;\n  --s-color-border-strong: #414B58;\n  --s-color-text: #F2F4F6;\n  --s-color-muted: #9BA3AE;\n  --s-color-subtle: #747E8C;\n  --s-color-accent: #F2CC4D;\n  --s-color-accent-hover: #FFDD6B;\n  --s-color-accent-soft: rgba(242, 204, 77, 0.07);\n  --s-color-success: #45BF92;\n  --s-color-success-soft: rgba(69, 191, 146, 0.09);\n  --s-color-danger: #EF7B6D;\n  --s-color-danger-soft: rgba(239, 123, 109, 0.09);\n  --s-space-1: 4px;\n  --s-space-2: 8px;\n  --s-space-3: 12px;\n  --s-space-4: 16px;\n  --s-space-5: 20px;\n  --s-space-6: 24px;\n  --s-space-8: 32px;\n  --s-space-10: 40px;\n  --s-space-12: 48px;\n  --s-space-16: 64px;\n  --s-space-20: 80px;\n  --s-radius-sm: 2px;\n  --s-radius-md: 4px;\n  --s-radius-lg: 6px;\n  --s-radius-xl: 8px;\n  --s-radius-pill: 999px;\n  --s-type-xs: 11px;\n  --s-type-sm: 12px;\n  --s-type-body: 14px;\n  --s-type-md: 16px;\n  --s-type-lg: 20px;\n  --s-type-xl: 28px;\n  --s-type-display: 52px;\n  --s-duration-fast: 120ms;\n  --s-duration-base: 180ms;\n  --s-duration-slow: 260ms;\n  --s-font: \"Sacra Mono\", \"Liga SFMono Nerd Font\", \"SF Mono\", \"SFMono-Regular\", Menlo, Monaco, Consolas, \"Liberation Mono\", monospace;\n  --s-line-body: 1.65;\n  --s-line-heading: 1.14;\n  --s-tracking-label: 0.12em;\n  --s-control-height: 40px;\n  --s-row-height: 58px;\n  --s-focus: 0 0 0 3px rgba(242, 204, 77, 0.22);\n  --s-shadow-overlay: 0 24px 80px rgba(0, 0, 0, 0.4);\n  --s-grid-unit: 24px;\n  --s-grid-columns: 12;\n  --s-rule-width: 1px;\n  --s-frame-marker: 9px;\n  --s-type-editorial: clamp(32px, 4.1vw, 64px);\n  --s-tracking-editorial: -.075em;\n  --s-line-editorial: 1.06;\n  --s-pattern-opacity: .28;\n}\n\n/* Components are namespaced with s-. The documentation layout is not required. */\n*, *::before, *::after { box-sizing: border-box; }\n.s-root { margin: 0; background: var(--s-color-canvas); color: var(--s-color-text); font: 400 var(--s-type-body)/var(--s-line-body) var(--s-font); -webkit-font-smoothing: antialiased; }\n.s-root button, .s-root input, .s-root select, .s-root textarea { font: inherit; }\n.s-root button, .s-root a, .s-root input, .s-root select, .s-root textarea, .s-root summary { -webkit-tap-highlight-color: transparent; }\n.s-root a { color: inherit; }\n.s-root button { cursor: pointer; }\n.s-root button:disabled { cursor: not-allowed; }\n.s-root :focus-visible { outline: 2px solid var(--s-color-accent); outline-offset: 4px; }\n.s-root ::selection { background: var(--s-color-accent); color: var(--s-color-canvas); }\n.s-root [hidden] { display: none !important; }\n.s-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }\n.s-icon { width: 18px; height: 18px; flex: 0 0 18px; fill: none; stroke: currentColor; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; vertical-align: middle; }\n.s-label { font-size: var(--s-type-xs); line-height: 1.5; font-weight: 600; letter-spacing: var(--s-tracking-label); text-transform: uppercase; }\n.s-muted { color: var(--s-color-muted); }\n.s-accent { color: var(--s-color-accent); }\n.s-success { color: var(--s-color-success); }\n.s-danger { color: var(--s-color-danger); }\n.s-row { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-space-3); }\n.s-stack { display: grid; gap: var(--s-space-4); }\n.s-btn { min-height: var(--s-control-height); display: inline-flex; justify-content: center; align-items: center; gap: 9px; padding: 9px 15px; border: 1px solid var(--s-color-border-strong); border-radius: var(--s-radius-md); background: transparent; color: var(--s-color-text); text-decoration: none; font-size: var(--s-type-sm) !important; line-height: 1.5; font-weight: 500 !important; white-space: nowrap; transition: background var(--s-duration-fast), border-color var(--s-duration-fast), color var(--s-duration-fast); }\n.s-btn:hover { background: var(--s-color-hover); border-color: var(--s-color-muted); }\n.s-btn:active:not(:disabled) { transform: translateY(1px); }\n.s-btn--primary { background: var(--s-color-accent); border-color: var(--s-color-accent); color: var(--s-color-canvas); }\n.s-btn--primary:hover { background: var(--s-color-accent-hover); border-color: var(--s-color-accent-hover); }\n.s-btn--ghost { border-color: transparent; color: var(--s-color-muted); }\n.s-btn--ghost:hover { color: var(--s-color-text); border-color: transparent; }\n.s-btn--danger { border-color: rgba(239,123,109,.3); color: var(--s-color-danger); background: var(--s-color-danger-soft); }\n.s-btn--danger:hover { border-color: var(--s-color-danger); background: rgba(239,123,109,.16); }\n.s-btn--sm { min-height: 32px; padding: 6px 10px; font-size: var(--s-type-xs) !important; border-radius: var(--s-radius-sm); }\n.s-btn--icon { width: var(--s-control-height); padding: 0; }\n.s-btn:disabled, .s-btn[aria-disabled=\"true\"] { color: var(--s-color-subtle); background: var(--s-color-surface); border-color: var(--s-color-border); opacity: .65; }\n.s-panel { background: var(--s-color-surface); border: 1px solid var(--s-color-border); border-radius: var(--s-radius-lg); overflow: hidden; }\n.s-panel__head { padding: 20px 24px; border-bottom: 1px solid var(--s-color-border); display: flex; align-items: center; justify-content: space-between; gap: 16px; }\n.s-panel__body { padding: var(--s-space-6); }\n.s-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 8px; border: 1px solid var(--s-color-border); border-radius: var(--s-radius-sm); color: var(--s-color-muted); font-size: var(--s-type-xs); line-height: 1.4; white-space: nowrap; }\n.s-badge--success { color: var(--s-color-success); border-color: rgba(69,191,146,.24); background: var(--s-color-success-soft); }\n.s-badge--danger { color: var(--s-color-danger); border-color: rgba(239,123,109,.24); background: var(--s-color-danger-soft); }\n.s-badge--accent { color: var(--s-color-accent); border-color: rgba(242,204,77,.24); background: var(--s-color-accent-soft); }\n.s-dot { display: inline-block; width: 5px; height: 5px; flex: 0 0 5px; border-radius: 50%; background: currentColor; }\n.s-field { display: grid; gap: var(--s-space-2); }\n.s-field__label { font-size: var(--s-type-sm); font-weight: 500; }\n.s-field__help { color: var(--s-color-muted); font-size: var(--s-type-xs); line-height: 1.65; margin: 0; }\n.s-input { width: 100%; min-height: var(--s-control-height); padding: 10px 12px; border: 1px solid var(--s-color-border-strong); border-radius: var(--s-radius-md); background: var(--s-color-sunken); color: var(--s-color-text); font-size: var(--s-type-sm) !important; line-height: 1.5; transition: border-color var(--s-duration-fast), box-shadow var(--s-duration-fast); }\n.s-input::placeholder { color: var(--s-color-subtle); opacity: 1; }\n.s-input:hover:not(:disabled) { border-color: var(--s-color-muted); }\n.s-input:focus { border-color: var(--s-color-accent); outline: none; box-shadow: var(--s-focus); }\n.s-input[aria-invalid=\"true\"] { border-color: var(--s-color-danger); }\n.s-input:disabled { color: var(--s-color-subtle); opacity: .6; cursor: not-allowed; }\ntextarea.s-input { min-height: 96px; resize: vertical; }\n.s-check { display: flex; align-items: center; gap: 10px; font-size: var(--s-type-sm); min-height: 32px; cursor: pointer; }\n.s-check input { width: 16px; height: 16px; margin: 0; accent-color: var(--s-color-accent); }\n.s-switch { display: inline-flex; align-items: center; gap: 12px; font-size: var(--s-type-sm); cursor: pointer; position: relative; }\n.s-switch input { position: absolute; width: 34px; height: 20px; opacity: 0; margin: 0; }\n.s-switch__track { position: relative; width: 34px; height: 20px; flex-shrink: 0; border: 1px solid var(--s-color-border-strong); border-radius: var(--s-radius-pill); background: var(--s-color-sunken); transition: background var(--s-duration-base); }\n.s-switch__track::before { content: \"\"; position: absolute; left: 3px; top: 3px; width: 12px; height: 12px; border-radius: 50%; background: var(--s-color-muted); transition: transform var(--s-duration-base); }\n.s-switch input:checked + .s-switch__track { background: var(--s-color-accent); border-color: var(--s-color-accent); }\n.s-switch input:checked + .s-switch__track::before { transform: translateX(14px); background: var(--s-color-canvas); }\n.s-switch input:focus-visible + .s-switch__track { outline: 2px solid var(--s-color-accent); outline-offset: 4px; }\n.s-switch input:disabled + .s-switch__track { opacity: .4; }\n.s-tabs { display: flex; flex-wrap: wrap; border-bottom: 1px solid var(--s-color-border); gap: var(--s-space-6); }\n.s-tab { position: relative; border: none; background: none; color: var(--s-color-muted); font-size: var(--s-type-sm) !important; padding: 14px 0; min-height: 44px; }\n.s-tab:hover { color: var(--s-color-text); }\n.s-tab[aria-selected=\"true\"] { color: var(--s-color-accent); }\n.s-tab[aria-selected=\"true\"]::after { content: \"\"; height: 2px; background: var(--s-color-accent); position: absolute; left: 0; right: 0; bottom: -1px; }\n.s-segment { display: inline-flex; gap: 4px; border: 1px solid var(--s-color-border); background: var(--s-color-canvas); border-radius: var(--s-radius-md); padding: 4px; }\n.s-segment button { padding: 6px 10px; min-height: 30px; background: none; border: 1px solid transparent; border-radius: var(--s-radius-sm); color: var(--s-color-muted); font-size: var(--s-type-xs) !important; white-space: nowrap; }\n.s-segment button[aria-pressed=\"true\"] { color: var(--s-color-text); background: var(--s-color-raised); border-color: var(--s-color-border); }\n.s-segment button:hover { color: var(--s-color-text); }\n.s-table-wrap { position: relative; overflow: auto; overscroll-behavior-x: contain; }\n.s-table { width: 100%; border-collapse: collapse; text-align: left; font-variant-numeric: tabular-nums; }\n.s-table th { color: var(--s-color-accent); padding: 14px 16px; font-size: var(--s-type-xs); font-weight: 600; line-height: 1.5; letter-spacing: .07em; text-transform: uppercase; border-bottom: 1px solid var(--s-color-accent); vertical-align: bottom; }\n.s-table td, .s-table tbody th { height: var(--s-row-height); padding: 13px 16px; border-bottom: 1px solid var(--s-color-border); font-size: var(--s-type-sm); }\n.s-table tbody th { color: var(--s-color-text); font-weight: 500; letter-spacing: normal; text-transform: none; vertical-align: middle; }\n.s-table tbody tr:last-child > * { border-bottom: 0; }\n.s-table tbody tr:hover { background: rgba(255,255,255,.018); }\n.s-table .is-highlight { background: var(--s-color-accent-soft); }\n.s-status { position: relative; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; font-size: var(--s-type-sm); }\n.s-status .s-icon { width: 20px; height: 20px; flex-basis: 20px; stroke-width: 2.35; }\n.s-kbd { display: inline-flex; align-items: center; justify-content: center; min-width: 21px; height: 21px; padding: 0 4px; color: var(--s-color-muted); background: var(--s-color-sunken); border: 1px solid var(--s-color-border-strong); border-bottom-width: 2px; border-radius: 4px; font: 400 10px/1 var(--s-font); }\n.s-alert { display: flex; align-items: flex-start; gap: 12px; padding: 16px; border: 1px solid var(--s-color-border); border-radius: var(--s-radius-md); font-size: var(--s-type-sm); }\n.s-alert--accent { border-color: rgba(242,204,77,.25); background: var(--s-color-accent-soft); }\n.s-alert--danger { border-color: rgba(239,123,109,.25); background: var(--s-color-danger-soft); }\n.s-alert p { margin: 0; }\n.s-alert .s-icon { margin-top: 1px; }\n.s-progress { width: 100%; height: 5px; border: none; display: block; border-radius: 2px; overflow: hidden; background: var(--s-color-border); accent-color: var(--s-color-accent); }\n.s-progress::-webkit-progress-bar { background: var(--s-color-border); }\n.s-progress::-webkit-progress-value { background: var(--s-color-accent); }\n.s-progress::-moz-progress-bar { background: var(--s-color-accent); }\n.s-dialog { color: var(--s-color-text); background: var(--s-color-surface); border: 1px solid var(--s-color-border-strong); border-radius: var(--s-radius-lg); padding: 0; width: min(580px, calc(100% - 32px)); max-height: 85dvh; box-shadow: var(--s-shadow-overlay); }\n.s-dialog::backdrop { background: rgba(0,0,0,.72); }\n.s-dialog__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 24px; border-bottom: 1px solid var(--s-color-border); }\n.s-dialog__body { padding: 24px; }\n.s-dialog__foot { padding: 16px 24px; display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--s-color-border); }\n.s-dialog h2 { font-size: 18px; margin: 0; font-weight: 600; }\n.s-toast { display: flex; align-items: center; gap: 10px; background: var(--s-color-raised); color: var(--s-color-text); border: 1px solid var(--s-color-border-strong); border-radius: var(--s-radius-md); padding: 12px 16px; font-size: var(--s-type-sm); box-shadow: var(--s-shadow-overlay); }\n.s-code { margin: 0; padding: 20px; background: var(--s-color-sunken); overflow: auto; color: var(--s-color-muted); font: 400 var(--s-type-sm)/1.8 var(--s-font); tab-size: 2; }\n.s-code code { font: inherit; }\n.s-code .key { color: var(--s-color-accent); }\n.s-code .value { color: var(--s-color-success); }\n.s-empty { display: grid; justify-items: center; gap: 12px; text-align: center; padding: 40px 24px; color: var(--s-color-muted); }\n.s-empty h3 { color: var(--s-color-text); margin: 4px 0 0; font-size: var(--s-type-md); }\n.s-empty p { font-size: var(--s-type-sm); margin: 0; }\n.s-skeleton { height: 12px; border-radius: 3px; background: var(--s-color-border); animation: s-pulse 1.8s ease-in-out infinite; }\n.s-spinner { width: 16px; height: 16px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: s-spin .7s linear infinite; }\n.s-card { background: var(--s-color-surface); border: 1px solid var(--s-color-border); border-radius: var(--s-radius-lg); padding: var(--s-space-5); }\n.s-card--interactive { transition: border-color var(--s-duration-fast), background var(--s-duration-fast), transform var(--s-duration-fast); }\n.s-card--interactive:hover { border-color: var(--s-color-border-strong); background: var(--s-color-raised); transform: translateY(-1px); }\n.s-metric { display: grid; gap: 6px; }\n.s-metric__label { color: var(--s-color-muted); font-size: var(--s-type-xs); text-transform: uppercase; letter-spacing: var(--s-tracking-label); }\n.s-metric__value { font-size: 28px; line-height: 1.15; font-weight: 500; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }\n.s-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 28px; padding: 4px 9px; border: 1px solid var(--s-color-border); border-radius: var(--s-radius-pill); background: var(--s-color-raised); color: var(--s-color-muted); font-size: var(--s-type-xs); white-space: nowrap; }\n.s-chip--active { color: var(--s-color-accent); border-color: rgba(242,204,77,.28); background: var(--s-color-accent-soft); }\n.s-divider { height: 1px; border: 0; margin: var(--s-space-4) 0; background: var(--s-color-border); }\n.s-list { margin: 0; padding: 0; list-style: none; border: 1px solid var(--s-color-border); border-radius: var(--s-radius-lg); overflow: hidden; }\n.s-list__item { min-height: 48px; display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: var(--s-color-surface); border-bottom: 1px solid var(--s-color-border); }\n.s-list__item:last-child { border-bottom: 0; }\n.s-list__item:hover { background: var(--s-color-raised); }\n.s-avatar { width: 32px; height: 32px; flex: 0 0 32px; display: grid; place-items: center; border-radius: var(--s-radius-md); border: 1px solid var(--s-color-border-strong); background: var(--s-color-raised); color: var(--s-color-accent); font-size: var(--s-type-xs); }\n.s-pagination { display: inline-flex; align-items: center; gap: 4px; }\n.s-page { min-width: 34px; height: 34px; padding: 0 8px; display: inline-grid; place-items: center; border: 1px solid transparent; border-radius: var(--s-radius-sm); background: transparent; color: var(--s-color-muted); font-size: var(--s-type-xs); }\n.s-page:hover { color: var(--s-color-text); background: var(--s-color-raised); border-color: var(--s-color-border); }\n.s-page[aria-current=\"page\"] { color: var(--s-color-canvas); background: var(--s-color-accent); border-color: var(--s-color-accent); }\n.s-toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-space-3); flex-wrap: wrap; }\n.s-menu { min-width: 190px; padding: 6px; border: 1px solid var(--s-color-border-strong); border-radius: var(--s-radius-md); background: var(--s-color-raised); box-shadow: var(--s-shadow-overlay); }\n.s-menu button, .s-menu a { width: 100%; min-height: 36px; display: flex; align-items: center; gap: 9px; padding: 7px 9px; border: 0; border-radius: var(--s-radius-sm); background: transparent; color: var(--s-color-text); text-decoration: none; text-align: left; font-size: var(--s-type-xs); }\n.s-menu button:hover, .s-menu a:hover { background: var(--s-color-hover); }\n.s-menu__danger { color: var(--s-color-danger) !important; }\n.s-tooltip { display: inline-block; padding: 6px 8px; border: 1px solid var(--s-color-border-strong); border-radius: var(--s-radius-sm); background: var(--s-color-raised); color: var(--s-color-text); font-size: 10px; box-shadow: var(--s-shadow-overlay); }\n\n@keyframes s-spin { to { transform: rotate(360deg); } }\n@keyframes s-pulse { 50% { opacity: .4; } }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation: none !important; transition: none !important; } }\n@media (max-width: 600px) { :root { --s-control-height: 44px; } .s-panel__head, .s-panel__body { padding: 18px; } .s-tabs { gap: 20px; } }\n\n\n/* SACRA / TECHNICAL EDITORIAL — shared visual vocabulary, 1.4.0.\n   All colours inherit the original graphite/yellow palette. */\n\n.s-kicker { display:flex; align-items:center; flex-wrap:wrap; gap:12px; font:600 var(--s-type-xs)/1.6 var(--s-font); letter-spacing:.1em; text-transform:uppercase; color:var(--s-color-accent); }\n.s-kicker::before { content:\"\"; width:7px; height:7px; background:currentColor; flex-shrink:0; }\n.s-editorial-title { font:600 var(--s-type-editorial)/var(--s-line-editorial) var(--s-font); letter-spacing:var(--s-tracking-editorial); text-transform:uppercase; margin:24px 0; }\n.s-editorial-title em { color:var(--s-color-accent); font-style:normal; }\n.s-editorial { border-block:1px solid var(--s-color-border-strong); padding:var(--s-space-8) 0; }\n.s-technical-label { color:var(--s-color-muted); font:400 var(--s-type-xs)/1.5 var(--s-font); letter-spacing:.07em; text-transform:uppercase; }\n.s-index { display:inline-flex; align-items:center; justify-content:center; color:var(--s-color-accent); border:1px solid var(--s-color-border-strong); padding:4px 8px; font-size:var(--s-type-xs); font-variant-numeric:tabular-nums; letter-spacing:.04em; }\n.s-register { display:flex; flex-wrap:wrap; gap:var(--s-space-4); justify-content:space-between; align-items:center; padding:var(--s-space-3) 0; border-block:1px solid var(--s-color-border-strong); font-size:var(--s-type-xs); color:var(--s-color-muted); }\n.s-register strong { font-weight:500; color:var(--s-color-text); }\n.s-tech-frame { position:relative; isolation:isolate; border:1px solid var(--s-color-border-strong); border-radius:0; background:var(--s-color-surface); }\n.s-tech-frame::before, .s-tech-frame::after { content:\"\"; position:absolute; width:var(--s-frame-marker); height:var(--s-frame-marker); pointer-events:none; z-index:2; border-color:var(--s-color-accent); }\n.s-tech-frame::before { left:-1px; top:-1px; border-left:1px solid; border-top:1px solid; color:var(--s-color-accent); }\n.s-tech-frame::after { right:-1px; bottom:-1px; border-right:1px solid; border-bottom:1px solid; color:var(--s-color-accent); }\n.s-tech-frame__head, .s-tech-frame__foot { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; padding:12px 16px; color:var(--s-color-muted); font-size:var(--s-type-xs); letter-spacing:.06em; }\n.s-tech-frame__head { border-bottom:1px solid var(--s-color-border); }\n.s-tech-frame__foot { border-top:1px solid var(--s-color-border); }\n.s-tech-frame__body { padding:var(--s-space-6); }\n.s-dotgrid { background-image:radial-gradient(circle, var(--s-color-border-strong) .75px, transparent 1px); background-size:var(--s-grid-unit) var(--s-grid-unit); background-position:12px 12px; }\n.s-hatch { background-image:repeating-linear-gradient(135deg, transparent 0 7px, var(--s-color-border) 7px 8px); }\n.s-scanlines { background-image:repeating-linear-gradient(0deg, transparent 0 5px, var(--s-color-border) 5px 6px); }\n.s-tech-frame__body > svg, .s-art { width:100%; height:auto; display:block; color:var(--s-color-accent); }\n.s-rail { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border:1px solid var(--s-color-border-strong); background:var(--s-color-surface); }\n.s-rail__cell { min-width:0; padding:20px; border-right:1px solid var(--s-color-border); }\n.s-rail__cell:last-child { border-right:0; }\n.s-rail__label { display:flex; align-items:center; gap:10px; color:var(--s-color-muted); font-size:10px; letter-spacing:.08em; text-transform:uppercase; }\n.s-rail__label span { color:var(--s-color-accent); }\n.s-rail__value { margin:10px 0 0; font-size:var(--s-type-sm); color:var(--s-color-text); }\n.s-readout { display:grid; grid-template-columns:1fr auto; align-items:baseline; gap:var(--s-space-3); font-variant-numeric:tabular-nums; }\n.s-readout__label { font-size:var(--s-type-xs); color:var(--s-color-muted); letter-spacing:.04em; text-transform:uppercase; }\n.s-readout__value { font:500 36px/1.1 var(--s-font); letter-spacing:-.06em; }\n.s-readout__value small { font-size:var(--s-type-sm); color:var(--s-color-muted); font-weight:400; letter-spacing:0; }\n.s-scale { display:flex; height:27px; border-bottom:1px solid var(--s-color-border-strong); justify-content:space-between; align-items:flex-end; }\n.s-scale > i { display:block; height:6px; width:1px; background:var(--s-color-border-strong); }\n.s-scale > i:nth-child(5n+1) { height:15px; background:var(--s-color-muted); }\n.s-scale--accent > i:nth-child(-n+16) { background:var(--s-color-accent); }\n.s-scale-labels { display:flex; justify-content:space-between; margin-top:7px; color:var(--s-color-muted); font-size:10px; font-variant-numeric:tabular-nums; }\n.s-split-title { display:flex; align-items:flex-start; gap:18px; margin-bottom:24px; }\n.s-split-title__index { font-size:var(--s-type-xs); color:var(--s-color-accent); border-top:2px solid var(--s-color-accent); padding-top:8px; min-width:30px; }\n.s-split-title h2, .s-split-title h3 { margin:0; font-weight:500; line-height:1.2; letter-spacing:-.045em; }\n.s-binary { display:flex; align-items:center; gap:2px; height:24px; color:var(--s-color-muted); }\n.s-binary > i { display:block; height:100%; width:2px; background:currentColor; }\n.s-binary > i:nth-child(3n) { width:4px; }\n.s-binary > i:nth-child(4n+1) { margin-right:3px; }\n.s-grid-demo { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:var(--s-space-2); }\n.s-grid-demo > i { min-width:0; min-height:96px; background:var(--s-color-accent-soft); border-inline:1px solid var(--s-color-border-strong); display:flex; align-items:flex-end; justify-content:center; padding-bottom:8px; color:var(--s-color-muted); font-size:9px; font-style:normal; }\n.s-btn--stamp { border-radius:2px; box-shadow:3px 3px 0 var(--s-color-border-strong); }\n.s-btn--stamp:hover { box-shadow:2px 2px 0 var(--s-color-border-strong); }\n.s-btn--stamp:active:not(:disabled) { box-shadow:0 0 0 var(--s-color-border-strong); transform:translate(2px,2px); }\n@media (max-width:600px) {\n  .s-rail { grid-template-columns:repeat(2,minmax(0,1fr)); }\n  .s-rail__cell { padding:16px; }\n  .s-rail__cell:nth-child(2n) { border-right:0; }\n  .s-rail__cell:nth-child(-n+2) { border-bottom:1px solid var(--s-color-border); }\n  .s-grid-demo { gap:4px; }\n  .s-grid-demo > i { font-size:8px; }\n}\n\n/* Motion, Charts and Workspace. Reusable components: s-*. Showcase: ds-*. */\n:root { --s-chart-height:280px; --s-motion-height:440px; --s-motion-fps:30; }\n.ds-section { scroll-margin-top:86px; }\n.ds-sidebar { overflow-y:auto; }\n.ds-nav { gap:2px; }\n.ds-nav-link { min-height:37px; padding-block:8px; }\n.ds-side-rule { margin-top:18px; padding-top:14px; }\n.ds-side-bottom { padding-top:16px; }\n.ds-side-bottom .ds-font-status { margin-bottom:12px; }\n.ds-main .s-code { max-width:100%; overflow-x:auto; }\n.ds-section__jump { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:18px 20px; margin-top:20px; border:1px solid var(--s-color-border-strong); }\n.ds-section__jump p { margin:0; color:var(--s-color-muted); font-size:11px; }\n.ds-section__jump .s-row { flex-shrink:0; }\n.ds-edition { color:var(--s-color-accent); font-size:10px; letter-spacing:.08em; }\n.ds-motion-layout { display:grid; grid-template-columns:minmax(0,1fr) 256px; border:1px solid var(--s-color-border-strong); background:var(--s-color-surface); }\n.ds-motion-layout > * { min-width:0; }\n.s-motion { position:relative; overflow:hidden; background:var(--s-color-surface); }\n.s-motion canvas { display:block; width:100%; height:var(--s-motion-height); cursor:grab; outline-offset:-5px; }\n.s-motion canvas:active { cursor:grabbing; }\n.ds-hero-art .s-motion { flex:1; }\n.ds-hero-art .s-motion canvas { height:100%; min-height:270px; position:absolute; inset:0; }\n.ds-hero-motion-foot { display:flex; gap:8px; align-items:center; }\n.ds-hero-motion-foot button { min-height:28px !important; padding:4px 8px; }\n.ds-motion-controls { padding:20px; border-left:1px solid var(--s-color-border-strong); display:flex; flex-direction:column; gap:19px; }\n.ds-motion-controls .s-row { gap:8px; }\n.s-control { display:grid; gap:8px; min-width:0; font-size:11px; }\n.s-control__label { display:flex; justify-content:space-between; align-items:center; gap:10px; color:var(--s-color-muted); }\n.s-control output { color:var(--s-color-text); font-variant-numeric:tabular-nums; }\n.s-control input[type=range] { width:100%; margin:4px 0; accent-color:var(--s-color-accent); }\n.s-control select { width:100%; }\n.s-select { appearance:auto; border:1px solid var(--s-color-border-strong); border-radius:var(--s-radius-sm); background:var(--s-color-surface); padding:9px 10px; min-height:38px; color:var(--s-color-text); font-size:11px!important; min-width:0; }\n.ds-motion-footer { border-top:1px solid var(--s-color-border-strong); display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); }\n.ds-motion-stat { padding:16px 18px; border-right:1px solid var(--s-color-border); }\n.ds-motion-stat:last-child { border-right:0; }\n.ds-motion-stat small { display:block; color:var(--s-color-muted); font-size:9px; text-transform:uppercase; letter-spacing:.06em; }\n.ds-motion-stat strong { display:block; font-size:18px; font-weight:500; margin-top:7px; font-variant-numeric:tabular-nums; }\n.ds-motion-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 16px; flex-wrap:wrap; border-bottom:1px solid var(--s-color-border-strong); font-size:10px; }\n.ds-motion-toolbar .s-badge { font-size:9px; }\n.ds-motion-presets { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-top:18px; }\n.ds-preset { margin:0; min-width:0; border:1px solid var(--s-color-border-strong); background:var(--s-color-surface); }\n.ds-preset .s-motion canvas { height:170px; cursor:default; }\n.ds-preset figcaption { border-top:1px solid var(--s-color-border); padding:10px 12px; display:flex; justify-content:space-between; align-items:center; gap:12px; font-size:10px; }\n.ds-preset figcaption span { color:var(--s-color-muted); }\n.s-source { border:1px solid var(--s-color-border-strong); background:var(--s-color-surface); margin-top:16px; }\n.s-source summary { padding:12px 16px; cursor:pointer; font-size:11px; color:var(--s-color-muted); }\n.s-source__body { padding:16px; border-top:1px solid var(--s-color-border); min-width:0; }\n.s-source__body .s-code { margin:0 0 12px; }\n.ds-source-cols { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:18px; }\n.ds-source-cols > * { min-width:0; }\n.s-note { border-left:2px solid var(--s-color-accent); background:var(--s-color-accent-soft); padding:13px 16px; color:var(--s-color-muted); font-size:11px; line-height:1.8; margin-top:18px; }\n.s-note strong { color:var(--s-color-text); font-weight:500; }\n.ds-chart-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; margin-top:22px; }\n.ds-chart-card { min-width:0; overflow:hidden; }\n.ds-chart-card .s-panel__head { padding:15px 18px; gap:12px; align-items:start; }\n.ds-chart-card h3 { margin:0; font-size:12px; font-weight:500; }\n.ds-chart-card small { color:var(--s-color-muted); font-size:9px; }\n.ds-chart-card .s-panel__body { padding:12px 16px 16px; }\n.s-chart { min-width:0; position:relative; }\n.s-chart__plot svg { display:block; width:100%; height:auto; overflow:visible; }\n.s-chart [data-point] { cursor:crosshair; outline:none; }\n.s-chart [data-point]:focus { stroke:var(--s-color-text); stroke-width:3px; opacity:1; }\n.s-chart [data-point].is-selected { stroke:var(--s-color-text); stroke-width:2.5px; }\n.s-chart__legend { display:flex; align-items:center; flex-wrap:wrap; gap:4px 14px; min-height:25px; }\n.s-chart__legend-item { display:inline-flex; align-items:center; gap:7px; padding:4px 0; border:0; background:none; color:var(--s-color-muted); font-size:10px!important; }\n.s-chart__legend-item i { display:block; width:13px; height:7px; }\nbutton.s-chart__legend-item[aria-pressed=false] { opacity:.5; text-decoration:line-through; }\n.s-chart__readout { font-size:10px; color:var(--s-color-muted); min-height:40px; padding-top:10px; line-height:1.7; overflow-wrap:anywhere; }\n.s-chart__tooltip { position:absolute; z-index:4; pointer-events:none; padding:9px 12px; max-width:min(280px, calc(100% - 16px)); border:1px solid var(--s-color-border-strong); background:var(--s-color-raised); color:var(--s-color-text); font-size:10px; box-shadow:var(--s-shadow-overlay); }\n.s-chart-actions { display:flex; gap:7px; flex-wrap:wrap; border-top:1px solid var(--s-color-border); padding-top:12px; }\n.s-chart-actions .s-btn { min-height:32px; padding:5px 9px; font-size:10px!important; }\n.s-data-details { margin-top:13px; font-size:10px; color:var(--s-color-muted); }\n.s-data-details summary { cursor:pointer; padding:6px 0; }\n.s-data-scroll { max-height:260px; overflow:auto; border-top:1px solid var(--s-color-border); margin-top:8px; }\n.s-data-scroll table { width:100%; border-collapse:collapse; text-align:left; }\n.s-data-scroll th,.s-data-scroll td { padding:9px 10px; border-bottom:1px solid var(--s-color-border); white-space:nowrap; }\n.s-data-scroll th { color:var(--s-color-accent); font-weight:500; background:var(--s-color-surface); position:sticky; top:0; }\n.s-data-scroll th button { border:0; background:none; color:inherit; padding:0; font-size:inherit; }\n.ds-chart-filters { display:flex; align-items:center; flex-wrap:wrap; justify-content:space-between; gap:14px; }\n.ds-chart-filters .s-row { gap:7px; }\n.s-btn[aria-pressed=true].s-filter { border-color:var(--s-color-accent); color:var(--s-color-accent); background:var(--s-color-accent-soft); }\n.s-workspace { background:var(--s-color-surface); border:1px solid var(--s-color-border-strong); }\n.s-workspace__bar { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; padding:16px 18px; border-bottom:1px solid var(--s-color-border-strong); font-size:11px; }\n.s-workspace__bar strong { font-weight:500; }\n.s-workspace__layout { display:grid; grid-template-columns:190px minmax(0,1fr); }\n.s-workspace__tree { border-right:1px solid var(--s-color-border-strong); padding:16px 12px; }\n.s-workspace__tree h4 { color:var(--s-color-muted); font-size:9px; font-weight:500; letter-spacing:.09em; margin:0 8px 16px; }\n.s-tree details { font-size:11px; }\n.s-tree summary { padding:10px 7px; cursor:pointer; color:var(--s-color-text); }\n.s-tree__items { padding-left:12px; border-left:1px solid var