rent; border:0; font-size:11px; }\n.s-commandblock__bar { display:flex; justify-content:space-between; gap:10px; align-items:center; font-size:10px; color:var(--s-color-muted); }\n.ds-new-library { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border:1px solid var(--s-color-border-strong); margin-top:20px; }\n.ds-new-library > div { padding:16px; border-right:1px solid var(--s-color-border); }\n.ds-new-library > div:last-child { border:0; }\n.ds-new-library strong { display:block; font-size:12px; font-weight:500; }\n.ds-new-library p { color:var(--s-color-muted); font-size:10px; margin-bottom:0; line-height:1.8; }\n.s-toast14 { position:fixed; right:24px; bottom:24px; z-index:70; max-width:min(410px,calc(100% - 32px)); background:var(--s-color-raised); border:1px solid var(--s-color-border-strong); border-left:2px solid var(--s-color-accent); padding:15px 18px; font-size:11px; }\n@media(max-width:1100px){ .ds-motion-layout { grid-template-columns:minmax(0,1fr) 220px; } .ds-motion-controls { padding:16px; } .ds-hero h1 { font-size:clamp(30px,4vw,53px); } .s-workspace__layout { grid-template-columns:155px minmax(0,1fr); } }\n@media(max-width:850px){ .ds-motion-layout { grid-template-columns:1fr; } .ds-motion-controls { border-left:0; border-top:1px solid var(--s-color-border-strong); display:grid; grid-template-columns:1fr 1fr; gap:17px; } .ds-chart-grid { grid-template-columns:1fr; } .ds-source-cols { grid-template-columns:1fr; } .s-workspace__layout { grid-template-columns:1fr; } .s-workspace__tree { border-right:0; border-bottom:1px solid var(--s-color-border-strong); padding:12px; } .s-workspace__tree h4 { margin-bottom:3px; } .s-tree__items { display:flex; flex-wrap:wrap; gap:4px; padding:5px; margin:0; border:0; } .s-tree button { width:auto; gap:12px; } .ds-section__jump { flex-wrap:wrap; } }\n@media(max-width:600px){ :root { --s-motion-height:310px; } .ds-motion-presets { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; } .ds-preset .s-m